rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Contact form submissions
    match /contact_submissions/{submissionId} {
      allow create, read, delete: if true;
      allow update: if false;
    }

    // Interpreter applications
    match /interpreter_submissions/{submissionId} {
      allow create, read, delete: if true;
      allow update: if false;
    }

    // Backend configuration settings
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Vozarals custom backend persistent tables (accessed by Express backend server)
    match /vozarals_settings/{docId} {
      allow read, write: if true;
    }

    match /vozarals_announcements/{annId} {
      allow read, write: if true;
    }

    match /vozarals_emails/{emailId} {
      allow read, write: if true;
    }

    match /vozarals_invitations/{invId} {
      allow read, write: if true;
    }

    match /vozarals_audit_logs/{logId} {
      allow read, write: if true;
    }

    match /vozarals_training/{trainId} {
      allow read, write: if true;
    }

    match /vozarals_career_roles/{roleId} {
      allow read, write: if true;
    }
  }
}
